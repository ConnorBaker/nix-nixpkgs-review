From 16159576027ed7b6a2607269e8e18388ddab4fd9 Mon Sep 17 00:00:00 2001
From: Connor Baker <connorbaker01@gmail.com>
Date: Fri, 9 Oct 2026 00:41:39 +0000
Subject: [PATCH 02/13] StorePath: validate without throwing, and with lookup
 tables

Parsing store paths is common during evaluation (e.g. every string
context element is parsed when strings are concatenated or coerced),
and the per-character range checks of the hash part and the name took
about a dozen instructions per character. Check the name's characters
with a table, and the hash part's with BaseNix32's existing one.

Also add StorePath::isValidBaseName(), which tells whether a base name
is valid without the cost of throwing an exception: the checks now
return their errors, and only the constructor and checkName() throw
them.
---
 src/libstore-tests/path.cc             | 17 +++++
 src/libstore/include/nix/store/path.hh |  5 ++
 src/libstore/path.cc                   | 86 ++++++++++++++++++--------
 3 files changed, 83 insertions(+), 25 deletions(-)

diff --git a/src/libstore-tests/path.cc b/src/libstore-tests/path.cc
index 4e4f9befe..208e9ab48 100644
--- a/src/libstore-tests/path.cc
+++ b/src/libstore-tests/path.cc
@@ -137,6 +137,23 @@ RC_GTEST_FIXTURE_PROP(StorePathTest, prop_check_regex_eq_parse, ())
     } catch (const BadStorePath &) {
     }
     RC_ASSERT(parsed == std::regex_match(std::string{name}, nameRegex));
+    RC_ASSERT(parsed == StorePath::isValidBaseName("575s52sh487i0ylmbs9pvi606ljdszr0-" + name));
+    RC_ASSERT(parsed == store->maybeParseStorePath(path).has_value());
+}
+
+TEST_F(StorePathTest, hashPartCharacters)
+{
+    std::string_view nix32 = "0123456789abcdfghijklmnpqrsvwxyz";
+    for (int i = 0; i < 256; ++i) {
+        auto c = static_cast<char>(i);
+        std::string baseName = "575s52sh487i0ylmbs9pvi606ljdszr" + std::string(1, c) + "-name";
+        bool valid = nix32.find(c) != nix32.npos;
+        EXPECT_EQ(StorePath::isValidBaseName(baseName), valid) << i;
+        if (valid)
+            EXPECT_NO_THROW(StorePath{baseName}) << i;
+        else
+            EXPECT_THROW(StorePath{baseName}, BadStorePath) << i;
+    }
 }
 
 TEST_F(StorePathTest, mustBeDashAfterHashPart)
diff --git a/src/libstore/include/nix/store/path.hh b/src/libstore/include/nix/store/path.hh
index 74ee0422b..eacf5ed41 100644
--- a/src/libstore/include/nix/store/path.hh
+++ b/src/libstore/include/nix/store/path.hh
@@ -44,6 +44,11 @@ public:
     /** @throws BadStorePath */
     StorePath(std::string_view baseName);
 
+    /**
+     * Whether `StorePath(baseName)` would succeed, without the cost of throwing an exception if it wouldn't.
+     */

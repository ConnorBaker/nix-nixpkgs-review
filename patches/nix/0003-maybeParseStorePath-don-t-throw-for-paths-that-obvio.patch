From 8a6237eceb51311ce9c0bf6518503563b769ab4e Mon Sep 17 00:00:00 2001
From: Connor Baker <connorbaker01@gmail.com>
Date: Thu, 8 Oct 2026 22:23:55 +0000
Subject: [PATCH 03/13] maybeParseStorePath: don't throw for paths that
 obviously aren't store paths

Exceptions are expensive, and maybeParseStorePath() is called for every
path that is coerced to a string, most of which aren't store paths.
Decide canonical paths (those that canonPath() would leave unchanged)
without parseStorePath(): they are store paths exactly if they are
directly in the store directory and StorePath::isValidBaseName() accepts
their base name.
---
 src/libstore/store-dir-config.cc | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/libstore/store-dir-config.cc b/src/libstore/store-dir-config.cc
index 962a3830f..d9350e125 100644
--- a/src/libstore/store-dir-config.cc
+++ b/src/libstore/store-dir-config.cc
@@ -29,6 +29,24 @@ StorePath StoreDirConfig::parseStorePath(std::string_view path) const
 
 std::optional<StorePath> StoreDirConfig::maybeParseStorePath(std::string_view path) const
 {
+#ifndef _WIN32
+    /* Exceptions are expensive, and this is called for every path that is coerced to a string (e.g. by
+       `EvalState::computeBaseName()`), most of which (e.g. files of a source tree in the store) aren't store paths.
+       So decide paths that `canonPath()` would leave unchanged without `parseStorePath()`: those are store paths
+       exactly if they are directly in the store directory and their base name is valid. */
+    auto isCanonical = [](std::string_view p) {
+        return !p.empty() && p[0] == '/' && (p.size() == 1 || p.back() != '/') && p.find("//") == p.npos
+               && p.find("/./") == p.npos && p.find("/../") == p.npos && !hasSuffix(p, "/.") && !hasSuffix(p, "/..");
+    };
+    if (storeDir.size() > 1 && isCanonical(path)) {
+        if (!(path.size() > storeDir.size() + 1 && hasPrefix(path, storeDir) && path[storeDir.size()] == '/'))
+            return std::nullopt;
+        auto baseName = path.substr(storeDir.size() + 1);
+        if (baseName.find('/') != baseName.npos || !StorePath::isValidBaseName(baseName))
+            return std::nullopt;
+        return StorePath(baseName);
+    }
+#endif
     try {
         return parseStorePath(path);
     } catch (Error &) {

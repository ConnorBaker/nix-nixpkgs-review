Subject: [PATCH 01/17] Add fingerprint-derivations setting

---
 src/libexpr/include/nix/expr/eval-settings.hh |  13 +
 src/libexpr/primops.cc                        | 262 +++++++++++++++++-
 2 files changed, 272 insertions(+), 3 deletions(-)

diff --git a/src/libexpr/include/nix/expr/eval-settings.hh b/src/libexpr/include/nix/expr/eval-settings.hh
index 9d0776139..54e9622a8 100644
--- a/src/libexpr/include/nix/expr/eval-settings.hh
+++ b/src/libexpr/include/nix/expr/eval-settings.hh
@@ -486,6 +486,19 @@ public:
           If set to true, flakes and trees fetched by [`builtins.fetchTree`](@docroot@/language/builtins.md#builtins-fetchTree) are only copied to the Nix store when they're used as a dependency of a derivation. This avoids copying (potentially large) source trees unnecessarily.
         )"};
 
+    Setting<bool> fingerprintDerivations{
+        this,
+        false,
+        "fingerprint-derivations",
+        R"(
+          If set to true (only allowed in read-only mode), `derivationStrict` does not serialise derivations or compute
+          their real store paths. Instead, it hashes their fields directly, and returns *fingerprints* formatted as store
+          paths: two derivations' fingerprinted `drvPath`s are equal if and only if their real `drvPath`s would be, and
+          likewise for their output paths. This is much cheaper, and is enough to tell which derivations changed between
+          two evaluations done with this setting, but the paths are not real store paths and must never be built or
+          compared with real ones.
+        )"};
+
     // FIXME: this setting should really be in libflake, but it's
     // currently needed in mountInput().
     Setting<bool> lazyLocks{
diff --git a/src/libexpr/primops.cc b/src/libexpr/primops.cc
index ced25790a..dc13b2138 100644
--- a/src/libexpr/primops.cc
+++ b/src/libexpr/primops.cc
@@ -1513,6 +1513,259 @@ static void checkDerivationName(EvalState & state, std::string_view drvName)
     }

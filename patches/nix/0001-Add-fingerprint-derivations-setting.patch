From c1d2dcdfc07dd790a98fb07e114c4a4ff69e4455 Mon Sep 17 00:00:00 2001
From: Connor Baker <ConnorBaker01@gmail.com>
Date: Wed, 28 Oct 2026 00:53:31 -0700
Subject: [PATCH 01/15] Add fingerprint-derivations setting

With `fingerprint-derivations` (only allowed in read-only mode),
`derivationStrict` doesn't serialise derivations or compute their real
store paths. Instead, it hashes their fields directly and returns
fingerprints formatted as store paths: two derivations' fingerprinted
derivation paths are equal if and only if their real ones would be, and
likewise for their output paths. That is enough to tell which
derivations changed between two evaluations made with this setting,
much more cheaply, but the paths are not real store paths and must
never be built or compared with real ones.

Fingerprints are computed from one hash of the derivation's fields
with its outputs masked:

- its hash modulo, as `hashDerivationModulo()` computes it, from that
  hash and its inputs' hashes modulo (fixed-output derivations use their
  real hashes modulo, which depend only on their content hashes); its
  output paths follow from this, as from the real one;
- its path, from that hash and its inputs' derivation paths.

The fields are collected into one buffer and hashed in one go, rather
than written to a `HashSink` (which allocates a large buffer and makes a
virtual call per write), and hashes are hashed again as their raw bytes,
without encoding them first. Fingerprint store paths are made directly
from the fingerprints rather than through `makeStorePath()`.
---
 src/libexpr/include/nix/expr/eval-settings.hh |  13 +
 src/libexpr/primops.cc                        | 295 +++++++++++++++++-
 2 files changed, 305 insertions(+), 3 deletions(-)

diff --git a/src/libexpr/include/nix/expr/eval-settings.hh b/src/libexpr/include/nix/expr/eval-settings.hh
index 9d0776139..54e9622a8 100644
--- a/src/libexpr/include/nix/expr/eval-settings.hh
+++ b/src/libexpr/include/nix/expr/eval-settings.hh
@@ -486,6 +486,19 @@ public:
           If set to true, flakes and trees fetched by [`builtins.fetchTree`](@docroot@/language/builtins.md#builtins-fetchTree) are only copied to the Nix store when they're used as a dependency of a derivation. This avoids copying (potentially large) source trees unnecessarily.
         )"};
 
+    Setting<bool> fingerprintDerivations{
+        this,
+        false,
+        "fingerprint-derivations",
+        R"(
+          If set to true (only allowed in read-only mode), `derivationStrict` does not serialise derivations or compute
+          their real store paths. Instead, it hashes their fields directly, and returns *fingerprints* formatted as store
+          paths: two derivations' fingerprinted `drvPath`s are equal if and only if their real `drvPath`s would be, and
+          likewise for their output paths. This is much cheaper, and is enough to tell which derivations changed between
+          two evaluations done with this setting, but the paths are not real store paths and must never be built or
+          compared with real ones.
+        )"};
+
     // FIXME: this setting should really be in libflake, but it's
     // currently needed in mountInput().
     Setting<bool> lazyLocks{
diff --git a/src/libexpr/primops.cc b/src/libexpr/primops.cc
index ced25790a..8c95e9d1b 100644
--- a/src/libexpr/primops.cc
+++ b/src/libexpr/primops.cc
@@ -1513,6 +1513,292 @@ static void checkDerivationName(EvalState & state, std::string_view drvName)
     }

+#include "nix/store/globals.hh"
+
+namespace nix {
+
+/**
+ * `fingerprint-derivations` must give equal fingerprints for two derivations exactly when their real `drvPath`s (or
+ * output paths) are equal. Evaluates the same derivations with and without it, and checks that the fingerprints and
+ * the real paths correspond one to one.
+ */
+class FingerprintDerivationsTest : public LibExprTest
+{
+protected:
+    void SetUp() override
+    {
+        LibExprTest::SetUp();
+        settings.readOnlyMode = true;
+        experimentalFeatureSettings.set("extra-experimental-features", "ca-derivations");
+    }
+
+    void TearDown() override
+    {
+        settings.readOnlyMode = false;
+        experimentalFeatureSettings.set("experimental-features", "pipe-operators");
+        LibExprTest::TearDown();
+    }
+
+    /**
+     * Each derivation's `drvPath` and output paths, as `<attr>.drvPath` and `<attr>.<output>`.
+     */
+    std::map<std::string, std::string> paths(EvalState & state)
+    {
+        auto expr = R"(
+          let
+            mk = args: derivation ({ system = "x86_64-linux"; builder = "/bin/sh"; } // args);
+            fetch =
+              url: mode:
+              mk {
+                name = "src";
+                inherit url;
+                outputHashMode = mode;
+                outputHashAlgo = "sha256";
+                outputHash = "sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=";
+              };
+            drvs = rec {
+              a = mk { name = "a"; };
+              aAgain = mk { name = "a"; };
+              aWithEnv = mk { name = "a"; x = "1"; };
+              aWithArgs = mk { name = "a"; args = [ "-c" "true" ]; };
+              aRenamed = mk { name = "b"; };
+
+              # The same fixed output, fetched from different places or in a different way.
+              src1 = fetch "https://example.org/1" "flat";
+              src2 = fetch "https://example.org/2" "flat";
+              srcRecursive = fetch "https://example.org/1" "recursive";
+              useSrc1 = mk { name = "use"; src = src1; };
+              useSrc2 = mk { name = "use"; src = src2; };
+              useSrcRecursive = mk { name = "use"; src = srcRecursive; };
+              useUseSrc1 = mk { name = "use2"; dep = useSrc1; };
+              useUseSrc2 = mk { name = "use2"; dep = useSrc2; };
+
+              multi = mk { name = "m"; outputs = [ "out" "dev" ]; };
+              multiReordered = mk { name = "m"; outputs = [ "dev" "out" ]; };
+              useOut = mk { name = "u"; dep = multi.out; };
+              useDev = mk { name = "u"; dep = multi.dev; };
+              useBoth = mk { name = "u"; dep = "${multi.out} ${multi.dev}"; };
+
+              structured = mk { name = "s"; __structuredAttrs = true; nested = { a = 1; b = [ true null "x" ]; }; };
+              structuredAgain = mk { name = "s"; __structuredAttrs = true; nested = { b = [ true null "x" ]; a = 1; }; };
+              structuredFloat = mk { name = "s"; __structuredAttrs = true; nested = { a = 1.0; b = [ true null "x" ]; }; };
+              structuredString = mk { name = "s"; __structuredAttrs = true; nested = { a = "1"; b = [ true null "x" ]; }; };
+              unstructured = mk { name = "s"; nested = "1"; };
+
+              ca = mk { name = "ca"; __contentAddressed = true; };
+              caAgain = mk { name = "ca"; __contentAddressed = true; };
+              caWithEnv = mk { name = "ca"; __contentAddressed = true; x = "1"; };
+              useCa = mk { name = "uc"; dep = ca; };
+              useCaWithEnv = mk { name = "uc"; dep = caWithEnv; };
+            };
+          in
+          builtins.unsafeDiscardStringContext (
+            builtins.toJSON (
+              builtins.mapAttrs (
+                _: d:
+                { drvPath = d.drvPath; }
+                // builtins.listToAttrs (map (o: { name = o; value = d.${o}.outPath; }) (d.outputs or [ "out" ]))
+              ) drvs
+            )
+          )
+        )";
+        Value v;
+        state.eval(state.parseExprFromString(expr, state.rootPath(CanonPath::root)), v);
+        state.forceValue(v, noPos);
+        std::map<std::string, std::string> res;
+        for (auto & [attr, drv] : nlohmann::json::parse(v.string_view()).items())
+            for (auto & [key, path] : drv.items())
+                res.emplace(attr + "." + key, path.get<std::string>());
+        return res;
+    }
+};
+
+TEST_F(FingerprintDerivationsTest, equalExactlyWhenRealPathsAreEqual)
+{
+    auto real = paths(state);
+
+    EvalSettings fingerprintSettings{readOnlyMode};
+    fingerprintSettings.nixPath = {};
+    fingerprintSettings.fingerprintDerivations = true;
+    EvalState fingerprintState({}, state.store, fetchSettings, fingerprintSettings, nullptr);
+    auto fingerprinted = paths(fingerprintState);
+
+    ASSERT_EQ(real.size(), fingerprinted.size());
+    std::map<std::string, std::string> realToFingerprint, fingerprintToReal;
+    for (auto & [key, realPath] : real) {
+        auto & fingerprint = fingerprinted.at(key);
+        /* Fixed-output derivations' output paths are real ones either way. */
+        if (key.ends_with(".drvPath")) {
+            EXPECT_NE(fingerprint, realPath) << key;
+        }
+        auto [i, newReal] = realToFingerprint.emplace(realPath, fingerprint);
+        EXPECT_EQ(i->second, fingerprint) << key << " has the same real path as a path with a different fingerprint";
+        auto [j, newFingerprint] = fingerprintToReal.emplace(fingerprint, realPath);
+        EXPECT_EQ(j->second, realPath) << key << " has the same fingerprint as a path with a different real path";
+    }
+
+    /* Check that the cases above test both directions. */
+    EXPECT_EQ(real.at("a.drvPath"), real.at("aAgain.drvPath"));
+    EXPECT_NE(real.at("src1.drvPath"), real.at("src2.drvPath"));
+    EXPECT_EQ(real.at("src1.out"), real.at("src2.out"));
+    EXPECT_NE(real.at("useSrc1.drvPath"), real.at("useSrc2.drvPath"));
+    EXPECT_EQ(real.at("useSrc1.out"), real.at("useSrc2.out"));
+    EXPECT_EQ(real.at("useUseSrc1.out"), real.at("useUseSrc2.out"));
+    EXPECT_NE(real.at("useSrc1.out"), real.at("useSrcRecursive.out"));
+    EXPECT_EQ(real.at("structured.drvPath"), real.at("structuredAgain.drvPath"));
+    EXPECT_NE(real.at("structured.drvPath"), real.at("structuredFloat.drvPath"));
+    EXPECT_NE(real.at("structured.drvPath"), real.at("structuredString.drvPath"));
+    EXPECT_NE(real.at("useCa.drvPath"), real.at("useCaWithEnv.drvPath"));
+}
+
+TEST_F(FingerprintDerivationsTest, requiresReadOnlyMode)
+{
+    settings.readOnlyMode = false;
+    EvalSettings fingerprintSettings{readOnlyMode};
+    fingerprintSettings.nixPath = {};
+    fingerprintSettings.fingerprintDerivations = true;
+    EvalState fingerprintState({}, state.store, fetchSettings, fingerprintSettings, nullptr);
+    auto expr = fingerprintState.parseExprFromString(
+        R"((derivation { name = "a"; system = "x86_64-linux"; builder = "/bin/sh"; }).drvPath)",
+        fingerprintState.rootPath(CanonPath::root));
+    Value v;
+    EXPECT_THROW(fingerprintState.eval(expr, v), UsageError);
+}
+
+} // namespace nix

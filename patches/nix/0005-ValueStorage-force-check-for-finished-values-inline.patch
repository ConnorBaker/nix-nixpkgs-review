From 216379799b787f71d0d759876bcce8bb4a52f935 Mon Sep 17 00:00:00 2001
From: Connor Baker <ConnorBaker01@gmail.com>
Date: Wed, 28 Oct 2026 07:53:17 -0700
Subject: [PATCH 05/13] ValueStorage::force(): check for finished values inline

Most values are already finished when they're forced, but every
forceValue() called the out-of-line force(), with its prologue and
epilogue (callee-saved registers, stack protector), only to find that
there was nothing to do. Check for that case inline and only call the
out-of-line part (now forceSlow(), which is never inlined) for thunks
and failed values.

Also always inline forceValue() and Value::type(): both are tiny, but
GCC still emitted out-of-line copies that about a hundred call sites
each called.
---
 src/libexpr/include/nix/expr/eval-inline.hh |  2 +-
 src/libexpr/include/nix/expr/eval.hh        |  2 +-
 src/libexpr/include/nix/expr/value.hh       | 24 +++++++++++++++++++--
 3 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/src/libexpr/include/nix/expr/eval-inline.hh b/src/libexpr/include/nix/expr/eval-inline.hh
index dafc4b52f..64d685657 100644
--- a/src/libexpr/include/nix/expr/eval-inline.hh
+++ b/src/libexpr/include/nix/expr/eval-inline.hh
@@ -115,7 +115,7 @@ Env & EvalMemory::allocEnv(size_t size)
 [[gnu::tls_model("initial-exec")]] extern thread_local uint32_t myEvalThreadId;
 
 template<std::size_t ptrSize>
-void ValueStorage<ptrSize, std::enable_if_t<detail::useBitPackedValueStorage<ptrSize>>>::force(
+void ValueStorage<ptrSize, std::enable_if_t<detail::useBitPackedValueStorage<ptrSize>>>::forceSlow(
     EvalState & state, PosIdx pos)
 {
     auto p0_ = p0.load(std::memory_order_acquire);
diff --git a/src/libexpr/include/nix/expr/eval.hh b/src/libexpr/include/nix/expr/eval.hh
index dec66fdd8..62f0d09aa 100644
--- a/src/libexpr/include/nix/expr/eval.hh
+++ b/src/libexpr/include/nix/expr/eval.hh
@@ -680,7 +680,7 @@ public:
      * application, call the function and overwrite `v` with the
      * result.  Otherwise, this is a no-op.
      */
-    inline void forceValue(Value & v, const PosIdx pos)
+    [[gnu::always_inline]] inline void forceValue(Value & v, const PosIdx pos)
     {
         v.force(*this, pos);
     }
diff --git a/src/libexpr/include/nix/expr/value.hh b/src/libexpr/include/nix/expr/value.hh
index 6d1298c72..fe4de5a9f 100644
--- a/src/libexpr/include/nix/expr/value.hh
+++ b/src/libexpr/include/nix/expr/value.hh
@@ -20,6 +20,7 @@
 #include "nix/util/source-path.hh"
 #include "nix/expr/print-options.hh"
 #include "nix/util/checked-arithmetic.hh"
+#include "nix/util/pos-idx.hh"
 
 #include <boost/unordered/unordered_flat_map_fwd.hpp>
 #include <nlohmann/json_fwd.hpp>
@@ -977,10 +978,29 @@ public:
         p0.store(pdPending, std::memory_order_relaxed);
     }
 
-    void force(EvalState & state, PosIdx pos);
+    /**
+     * Evaluate the value to weak head normal form, if it isn't already.
+     */
+    [[gnu::always_inline]] void force(EvalState & state, PosIdx pos)
+    {
+        /* Most values are forced when they're already finished, so
+           check for that inline. */
+        auto p0_ = p0.load(std::memory_order_acquire);
+        auto pd = static_cast<PrimaryDiscriminator>(p0_ & discriminatorMask);
+        if (!isUnfinished(pd) && InternalType(p0_ & 0xff) != tFailed) [[likely]]
+            return;
+        forceSlow(state, pos);
+    }
 
 private:
 
+    /**
+     * The out-of-line part of `force()`, for values that are not
+     * finished or have failed. Never inlined, so that `force()` stays
+     * small at its many call sites.
+     */
+    [[gnu::noinline]] void forceSlow(EvalState & state, PosIdx pos);
+
     /**
      * Given a thunk that was observed to be in the pending or awaited
      * state, wait for it to finish. Returns the first word of the
@@ -1296,7 +1316,7 @@ public:
      * Returns the normal type of a Value. This only returns nThunk if
      * the Value hasn't been forceValue'd
      */
-    inline ValueType type() const
+    [[gnu::always_inline]] inline ValueType type() const
     {
         /* Explicit lookup table. switch() might compile down (and it does at least with GCC 14)
            to a jump table. Let's help the compiler a bit here. */

From 7c49a6f2046a3d2f93f21648ff459ce908f3ace2 Mon Sep 17 00:00:00 2001
From: Connor Baker <connorbaker01@gmail.com>
Date: Fri, 9 Oct 2026 00:00:23 +0000
Subject: [PATCH 03/17] ValueStorage::finish(): avoid an atomic exchange for
 values that aren't being forced

Copying a value or writing a result into a fresh value or a temporary
used an atomic exchange (a locked instruction and full barrier on
x86-64) to detect waiters, even though only a pending/awaited thunk can
have waiters. Check the current state with a relaxed load first and use
a plain release store in the common case.
---
 src/libexpr/include/nix/expr/value.hh | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/libexpr/include/nix/expr/value.hh b/src/libexpr/include/nix/expr/value.hh
index aadb05f62..48641cc84 100644
--- a/src/libexpr/include/nix/expr/value.hh
+++ b/src/libexpr/include/nix/expr/value.hh
@@ -683,6 +683,20 @@ class alignas(16)
     {
         // Note: p1 *must* be updated before p0.
         p1 = p1_;
+
+        /* Only a value that is being forced (i.e. that is "pending"
+           or "awaited") can be modified concurrently by another
+           thread, which may change it from "pending" to
+           "awaited". Any other value (e.g. a freshly allocated value
+           or a temporary) can be updated with a plain store, avoiding
+           a costly atomic exchange. Since the "pending" state can only
+           have been set by this thread, this load cannot miss it. */
+        auto pd0 = static_cast<PrimaryDiscriminator>(p0.load(std::memory_order_relaxed) & discriminatorMask);
+        if (pd0 != pdPending && pd0 != pdAwaited && pd0 != pdThunk) [[likely]] {
+            p0.store(p0_, std::memory_order_release);
+            return;
+        }
+
         p0_ = p0.exchange(p0_, std::memory_order_release);
 
         auto pd = static_cast<PrimaryDiscriminator>(p0_ & discriminatorMask);
